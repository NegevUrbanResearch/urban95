{
  "name": "urban95",
  "version": "1.0.0",
  "description": "A spatial analysis project to visualize and assess how child-friendly different parts of Beer Sheva's streetscape are. This project is a collaboration between **Urban95** and **NUR** as part of the \"Cities for Children\" initiative.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "http-server . -c-1",
    "start:docs": "http-server docs -c-1",
    "test": "node --test tests/frontend/module_contracts.test.js tests/frontend/score_model.test.js tests/frontend/control_sidebar.test.js",
    "test:frontend": "node --test tests/frontend/module_contracts.test.js tests/frontend/score_model.test.js tests/frontend/control_sidebar.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NegevUrbanResearch/urban95.git"
  },
